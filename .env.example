# QALQAN Voice Runtime Configuration
QALQAN_HOST=0.0.0.0
QALQAN_PORT=8000
QALQAN_DEFAULT_LANG=ru
QALQAN_SAMPLE_RATE=16000
QALQAN_THRESHOLD_SYNTHETIC=0.65
QALQAN_THRESHOLD_SUSPICIOUS=0.40
QALQAN_NN_BLEND_WEIGHT=0.65

# Optional: path to trained PyTorch QalqanLCNN checkpoint (falls back to acoustic-physics mode if absent)
QALQAN_MODEL_PATH=models/qalqan_lcnn.pt

# Optional: Telegram BotFather token for running `python -m qalqan.bot.telegram_bot`
QALQAN_TELEGRAM_TOKEN=
